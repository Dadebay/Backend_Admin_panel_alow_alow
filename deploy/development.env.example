# Deployed DEV should use production-safe runtime rules with isolated data.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@postgres-dev.example.com:5432/alowalow_dev?sslmode=require
REDIS_URL=rediss://user:password@redis-dev.example.com:6379/1
JWT_ACCESS_SECRET=replace-with-a-dev-secret-of-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-dev-random-secret
SMS_PROVIDER=android_pull
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_GATEWAY_DEVICE_ID=android-development
SMS_GATEWAY_DEVICE_TOKEN=replace-with-a-dev-device-secret-of-at-least-32-characters
SMS_GATEWAY_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=https://dev-admin.example.com
MAX_IMAGE_BYTES=5242880
S3_REGION=us-east-1
S3_BUCKET=alowalow-media-development
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
DISPATCH_PICKUP_NAME=AlowAlow DEV
DISPATCH_PICKUP_ADDRESS=
DISPATCH_PICKUP_LATITUDE=
DISPATCH_PICKUP_LONGITUDE=
