# Deployed DEV should use production-safe runtime rules with isolated data.
# Public DEV still uses production-safe application behavior: no OTP devCode,
# explicit HTTPS CORS and Android-pull SMS.
NODE_ENV=production
PORT=4000
POSTGRES_DB=alowalow_dev
POSTGRES_USER=alowalow_dev
POSTGRES_PASSWORD=replace-with-a-dev-postgres-password
DATABASE_URL=postgresql://alowalow_dev:replace-with-a-dev-postgres-password@postgres:5432/alowalow_dev?schema=public
REDIS_PASSWORD=replace-with-a-url-safe-dev-redis-password
REDIS_URL=rediss://:replace-with-a-url-safe-dev-redis-password@redis:6379/1
ROUTING_URL=http://routing:5000
ROUTING_TIMEOUT_MS=3000
JWT_ACCESS_SECRET=replace-with-a-dev-secret-of-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-dev-random-secret
SMS_PROVIDER=android_pull
SMS_GATEWAY_DEVICE_ID=android-development
SMS_GATEWAY_DEVICE_TOKEN=replace-with-a-dev-device-secret-of-at-least-32-characters
SMS_GATEWAY_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_BASE64=replace-with-single-line-base64-service-account-json
PUSH_DISPATCH_INTERVAL_MS=5000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=https://PUBLIC_SERVER_IP:8443
MAX_IMAGE_BYTES=5242880
S3_REGION=us-east-1
S3_BUCKET=alowalow-media-development
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=replace-with-a-dev-minio-user
S3_SECRET_ACCESS_KEY=replace-with-a-dev-minio-password
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=replace-with-the-same-dev-minio-user
MINIO_ROOT_PASSWORD=replace-with-the-same-dev-minio-password
