NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://alofood:alofood@localhost:5432/alofood?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_IMAGE_BYTES=5242880
S3_REGION=us-east-1
S3_BUCKET=alo-food-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=alofood
S3_SECRET_ACCESS_KEY=alofood-local-secret
S3_FORCE_PATH_STYLE=true
