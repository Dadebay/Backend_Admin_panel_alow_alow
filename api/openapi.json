        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "NEW",
                "CONFIRMED",
                "SENT_TO_KITCHEN",
                "COOKING",
                "READY",
                "ASSIGNED_TO_COURIER",
                "OUT_FOR_DELIVERY",
                "DELIVERED",
                "CASH_RETURNED",
                "COMPLETED",
                "RECONCILED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 100,
              "default": 25,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List orders visible to the current role",
